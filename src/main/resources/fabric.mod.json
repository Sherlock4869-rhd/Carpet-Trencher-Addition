{
	"schemaVersion": 1,
	"id": "carpet-trencher-addition",
	"version": "${version}",

	"name": "Carpet Trencher Addition",
	"description": "A Carpet addition designed to help players use trenchers by providing some not vanilla rules.",
	"authors": [
		"Sherlock4869_rhd"
	],

	"contact": {
		"homepage": "https://github.com/Sherlock4869-rhd/Carpet-Trencher-Addition",
		"sources": "https://github.com/Sherlock4869-rhd/Carpet-Trencher-Addition",
		"issues": "https://github.com/Sherlock4869-rhd/Carpet-Trencher-Addition/issues"
	},

	"license": "MIT",

	"icon": "assets/carpet-trencher-addition/icon.png",

	"environment": "*",

	"entrypoints": {
		"main": [
			"com.carpet.trencher.addition.CarpetTrencherAdditionMod"
		],
		"client": [
			"com.carpet.trencher.addition.CarpetTrencherAdditionClient"
		]
	},

	"mixins": [
		"carpet-trencher-addition.mixins.json",
		{
			"config": "carpet-trencher-addition.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraftVer}",
		"fabric-api": "*",
		"carpet": "*"
	}
}